{
    // Infection (https://infection.github.io): mutation testing of src/ with the PHPUnit tests
    // (composer mutation, needs pcov or Xdebug)
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "phpUnit": {
        "configDir": "."
    },
    // The whole suite runs in about 2 s: a mutant still running after 10 s loops
    "timeout": 10,
    // Fails below these (92.31% with #67 when they were last raised): they stay at 92, never
    // lowered to let a change through
    "minMsi": 92,
    "minCoveredMsi": 92,
    // In build/infection/: the escaped mutants (infection.log, infection.html), and the counts
    // and the MSI (summary.json, shown by the CI job)
    "logs": {
        "text": "build/infection/infection.log",
        "html": "build/infection/infection.html",
        "summaryJson": "build/infection/summary.json"
    },
    "mutators": {
        "@default": true
    }
}
