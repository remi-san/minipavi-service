{
    "name": "remi-san/minipavi-service",
    "description": "Framework for Minitel services on MiniPavi: XML pages and templates, controllers, routing",
    "license": "GPL-3.0-or-later",
    "type": "library",
    "bin": ["bin/minipavi"],
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "ludosevilla/minipavi-cli": "^1.1.1",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/log": "^3.0",
        "symfony/console": "^7.1"
    },
    "require-dev": {
        "carthage-software/mago": "^1.60",
        "infection/infection": "^0.32.6",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "monolog/monolog": "A PSR-3 logger for the service, e.g. to PHP's error log (ErrorLogHandler)",
        "phpunit/phpunit": "For Testing\\ServiceTester, functional tests of a service (^11.5)"
    },
    "autoload": {
        "psr-4": { "MiniPaviService\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MiniPaviService\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": [
            "phpunit --coverage-text --coverage-clover coverage.xml",
            "@php tools/coverage-minimum.php coverage.xml 98.4"
        ],
        "analyse": [
            "mago lint",
            "mago analyze",
            "mago guard"
        ],
        "mutation": [
            "@putenv UPDATE_GOLDEN=0",
            "@php -d memory_limit=1G vendor/bin/infection --threads=max"
        ],
        "cs": "mago format --check",
        "cs-fix": "mago format"
    },
    "scripts-descriptions": {
        "test": "Runs the tests",
        "coverage": "Runs the tests with coverage (needs pcov or Xdebug): as text, and in coverage.xml; fails below 98.4% of lines",
        "analyse": "Runs the linter, the static analysis and the layers' dependencies check (Mago)",
        "mutation": "Runs the mutation testing (Infection, needs pcov or Xdebug), its logs in build/infection/",
        "cs": "Checks the formatting (Mago)",
        "cs-fix": "Formats the code (Mago)"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": false
        }
    }
}
