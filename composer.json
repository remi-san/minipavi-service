{
    "name": "minipavi-stack/framework",
    "description": "Framework for Minitel services on MiniPavi: XML pages and templates, controllers, routing",
    "license": "GPL-3.0-or-later",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "ludosevilla/minipavi-cli": "^1.1.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "MiniPaviService\\": "src/" },
        "files": ["bootstrap.php"]
    },
    "autoload-dev": {
        "psr-4": { "MiniPaviService\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "scripts-descriptions": {
        "test": "Runs the tests",
        "cs": "Checks the coding style, showing what would change",
        "cs-fix": "Fixes the coding style"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
